# Regressão Linear
Objetivo: Entender o efeito causal do abuso de álcool (abuse) sobre empregabilidade (employ)

1-Importação de dados / pacotes
install.packages("wooldridge")
library(wooldridge)

install.packages("AER") #para usar função de VI
library(AER) 

data('alcohol')

#2-Definição o modelo de regressão
#variável dependente / endógena = abuse (1 se a pessoa está empregada, 0 caso contrário)
#variável independente / exógena = employ (se a pessoa abusa de álcool, 0 caso contrário)

reg_simples <- lm(employ ~ abuse, data = alcohol )
summary(reg_simples)

#3-Resultado
